        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{JSON.stringify([{ url: $json.fb_page_url, num_of_posts: 10000, start_date: $json.start_date, end_date: $json.end_date }])}}",
        "options": {
