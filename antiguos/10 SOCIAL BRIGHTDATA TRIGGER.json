    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst ok = items.filter(i => (i.json.statusCode || 200) < 400).length;\nconsole.log(`BrightData trigger: ${ok}/${items.length} accounts OK`);\nreturn [{ json: { triggered_ok: ok, triggered_error: items.length - ok, total: items.length, triggered_at: new Date().toISOString() } }];"
      },
