      },
      "id": "brightdata-download-snapshot",
      "name": "Download Snapshot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        320,
        0
      ],
      "credentials": {
        "httpBearerAuth": {
          "id": "0rTspKriNsoJizFz",
          "name": "BRIGHT DATA"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst text = item.json.data || item.json.body || '';\nconst snapshotId = String($('Trigger BrightData').item.json.snapshot_id || 'unknown');\nconst aytoRaw = String($('Get Active Accounts').item.json.ayto_id || 'unknown_ayto');\nconst startDate = String($('Get Active Accounts').item.json.start_date || '');\nconst yearFromStart = Number(startDate.slice(0, 4));\nconst year = Number.isFinite(yearFromStart) && yearFromStart > 2000\n    ? String(Math.trunc(yearFromStart))\n    : String(new Date().getFullYear());\n\nconst safeAyto = aytoRaw\n    .trim()\n    .toLowerCase()\n    .replace(/[^a-z0-9._-]+/g, '_')\n    .replace(/^_+|_+$/g, '')\n    .slice(0, 80) || 'unknown_ayto';\n\nconst stamp = new Date().toISOString().replace(/[:.]/g, '-');\nconst filePath = '/srv/storage/redessociales/brightdata/' + safeAyto + '/' + year + '/snapshot_' + snapshotId + '_' + stamp + '.ndjson';\nconst binaryData = await this.helpers.prepareBinaryData(Buffer.from(String(text), 'utf8'), 'snapshot.ndjson', 'text/plain');\n\nreturn {\n    json: {\n        ...item.json,\n        snapshot_file_path: filePath,\n        snapshot_id: snapshotId,\n        snapshot_ayto_id: safeAyto,\n        snapshot_year: year,\n    },\n    binary: {\n        snapshot_data: binaryData,\n    },\n};"
      },
      "id": "brightdata-build-snapshot-path",
      "name": "Build Snapshot File Path",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        544,
        0
      ]
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "={{ $json.snapshot_file_path }}",
        "dataPropertyName": "snapshot_data",
        "options": {}
      },
      "id": "brightdata-write-snapshot-file",
      "name": "Write Snapshot File",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1.1,
      "position": [
        768,
        0
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const text = $input.item.json.data || $input.item.json.body || '';\nconst snapshotId = $('Trigger BrightData').item.json.snapshot_id || '';\nconst accountId = $('Get Active Accounts').item.json.publisher_account_id;\nconst aytoId = $('Get Active Accounts').item.json.ayto_id;\nconst accountName = $('Get Active Accounts').item.json.account_name;\nconst lines = text.split('\n').filter(l => l.trim());\nconst posts = [];\nfor (const line of lines) {\n  try {\n    const obj = JSON.parse(line);\n    if (obj && (obj.url || obj.post_url || obj.post_id || obj.id)) {\n      obj._ayto_id = aytoId;\n      obj._account_name = accountName;\n      obj._publisher_account_id = accountId;\n      posts.push(obj);\n    }\n  } catch (e) { /* skip malformed lines */ }\n}\nreturn [{ json: { posts, snapshot_id: snapshotId, publisher_account_id: accountId } }];"
      },
      "id": "brightdata-convert-ndjson",
      "name": "Convert Ndjson",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        992,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://ingesta.sistechvision.online/webhook/social/brightdata/facebook",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.posts) }}",
        "options": {
          "response": {},
          "timeout": 30000
        }
      },
      "id": "brightdata-send-to-ingest",
      "name": "Send To Ingest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1216,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO processing_logs\n  (entity_type, entity_id, workflow_name, phase, status, message, details_json)\nVALUES (\n  'publisher_account',\n  $1::bigint,\n  'social_brightdata_trigger',\n  'INGEST_TRIGGER',\n  $2,\n  $3,\n  $4::jsonb\n)\nRETURNING id;",
        "options": {
          "queryReplacement": "={{ [\n  Number($('Get Active Accounts').item.json.publisher_account_id),\n  ($input.first().json.statusCode || 200) < 400 ? 'SUCCESS' : 'ERROR',\n  'BrightData trigger: ' + $('Get Active Accounts').item.json.account_name + ' | start=' + $('Get Active Accounts').item.json.start_date + ' | end=' + $('Get Active Accounts').item.json.end_date,\n  JSON.stringify({\n    ayto_id: $('Get Active Accounts').item.json.ayto_id,\n    fb_page_url: $('Get Active Accounts').item.json.fb_page_url,\n    start_date: $('Get Active Accounts').item.json.start_date,\n    end_date: $('Get Active Accounts').item.json.end_date,\n        snapshot_file_path: ($('Build Snapshot File Path').item.json.snapshot_file_path || ''),\n    brightdata_response: $input.first().json,\n  })\n] }}"
        }
      },
      "id": "brightdata-log-trigger",
      "name": "Log Trigger",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
