import { workflow, node, links } from '@n8n-as-code/transformer';

// <workflow-map>
// Workflow : SCRAPPER FLOWTE
// Nodes   : 15  |  Connections: 14
//
// NODE INDEX
// ──────────────────────────────────────────────────────────────────
// Property name                    Node type (short)         Flags
// SplitOut                           splitOut
// ExecuteASqlQuery1                  postgres                   [creds]
// Wait                               wait
// ScheduleTrigger                    scheduleTrigger
// LoadPromoterConfig                 postgres                   [creds]
// NormalizarEventos                  code
// WhenClickingExecuteWorkflow        manualTrigger
// InsertNormalizedEvents             postgres                   [creds]
// Scrape                             firecrawl                  [creds] [retry]
// WebhookTrigger                     webhook
// NormalizarTitulo                   code
// ExecuteASqlQueryFront              postgres                   [creds]
// Scrape1                            firecrawl                  [creds]
// ParsearEventos                     code
// LoopOverItems                      splitInBatches
//
// ROUTING MAP
// ──────────────────────────────────────────────────────────────────
// ScheduleTrigger
//    → LoadPromoterConfig
const MONTHS = {
  JAN: '01', ENERO: '01',
  FEB: '02', FEBRERO: '02',
  MAR: '03', MARZO: '03',
  APR: '04', ABR: '04', ABRIL: '04',
  MAY: '05', MAYO: '05',
  JUN: '06', JUNIO: '06',
  JUL: '07', JULIO: '07',
  AUG: '08', AGO: '08', AGOSTO: '08',
  SEP: '09', SEPT: '09', SEPTIEMBRE: '09',
  OCT: '10', OCTUBRE: '10',
  NOV: '11', NOVIEMBRE: '11',
  DEC: '12', DIC: '12', DICIEMBRE: '12',
};

function normalizeText(value) {
  return (value || '')
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/\s+/g, ' ')
    .trim()
    .toUpperCase();
}

function formatDate(year, monthToken, day) {
  const month = MONTHS[monthToken] || '';
  if (!year || !month || !day) return '';
  return year + '-' + String(month).padStart(2, '0') + '-' + String(day).padStart(2, '0');
}

function estimateSessions(startDate, endDate) {
  if (!startDate) return null;
  if (!endDate) return 1;
  const start = new Date(startDate + 'T00:00:00Z');
  const end = new Date(endDate + 'T00:00:00Z');
  if (Number.isNaN(start.getTime()) || Number.isNaN(end.getTime()) || end < start) return null;
  return Math.round((end.getTime() - start.getTime()) / 86400000) + 1;
}

function parseDateTimeText(originalText) {
  const datetimeTextOriginal = (originalText || '').replace(/\s+/g, ' ').trim();
  const normalized = normalizeText(datetimeTextOriginal);
  const timeMatches = Array.from(normalized.matchAll(/\b(\d{1,2}:\d{2})\b/g)).map((match) => match[1]);
  const uniqueTimes = Array.from(new Set(timeMatches));

  if (!normalized) {
    return {
      datetime_text_original: '',
      fecha_inicio: '',
      fecha_fin: '',
      hora_inicio: '',
      tipo_fecha: 'texto_no_parseable',
      num_sesiones_estimadas: null,
      tiene_multiples_sesiones: false,
    };
  }

  if (uniqueTimes.length > 1) {
    return {
      datetime_text_original: datetimeTextOriginal,
      fecha_inicio: '',
      fecha_fin: '',
      hora_inicio: '',
      tipo_fecha: 'multiple_sesiones',
      num_sesiones_estimadas: null,
      tiene_multiples_sesiones: true,
    };
  }

  let dateMatches = Array.from(normalized.matchAll(/(?:MON|TUE|WED|THU|FRI|SAT|SUN|LUN|MAR|MIE|JUE|VIE|SAB|DOM)?\s*(\d{1,2})\s+(JAN|ENERO|FEB|FEBRERO|MAR|MARZO|APR|ABR|ABRIL|MAY|MAYO|JUN|JUNIO|JUL|JULIO|AUG|AGO|AGOSTO|SEP|SEPT|SEPTIEMBRE|OCT|OCTUBRE|NOV|NOVIEMBRE|DEC|DIC|DICIEMBRE)\s+(\d{4})/g));

  const spanishRangeSameMonth = normalized.match(/^(\d{1,2})(?:\s+Y\s+(\d{1,2}))?\s+DE\s+(ENERO|FEBRERO|MARZO|ABRIL|MAYO|JUNIO|JULIO|AGOSTO|SEPTIEMBRE|OCTUBRE|NOVIEMBRE|DICIEMBRE)\s+DE\s+(\d{4})/);
  if (dateMatches.length === 0 && spanishRangeSameMonth) {
    const firstDay = spanishRangeSameMonth[1];
    const secondDay = spanishRangeSameMonth[2] || spanishRangeSameMonth[1];
    const monthToken = spanishRangeSameMonth[3];
    const year = spanishRangeSameMonth[4];
    dateMatches = [
      ['', firstDay, monthToken, year],
      ['', secondDay, monthToken, year],
    ];
  }

  if (dateMatches.length === 0) {
    return {
      datetime_text_original: datetimeTextOriginal,
      fecha_inicio: '',
      fecha_fin: '',
      hora_inicio: uniqueTimes[0] || '',
      tipo_fecha: 'texto_no_parseable',
      num_sesiones_estimadas: null,
      tiene_multiples_sesiones: false,
    };
  }

  const uniqueDates = [];
  for (const match of dateMatches) {
    const formatted = formatDate(match[3], match[2], match[1]);
    if (formatted && !uniqueDates.includes(formatted)) {
      uniqueDates.push(formatted);
    }
  }

  if (uniqueDates.length === 0) {
    return {
      datetime_text_original: datetimeTextOriginal,
      fecha_inicio: '',
      fecha_fin: '',
      hora_inicio: uniqueTimes[0] || '',
      tipo_fecha: 'texto_no_parseable',
      num_sesiones_estimadas: null,
      tiene_multiples_sesiones: false,
    };
  }

  const fechaInicio = uniqueDates[0];
  const fechaFin = uniqueDates.length > 1 ? uniqueDates[uniqueDates.length - 1] : fechaInicio;
  const horaInicio = uniqueTimes[0] || '';
  const tipoFecha = uniqueDates.length > 1 && horaInicio ? 'rango_misma_hora' : 'simple';

  return {
    datetime_text_original: datetimeTextOriginal,
    fecha_inicio: fechaInicio,
    fecha_fin: fechaFin,
    hora_inicio: horaInicio,
    tipo_fecha: tipoFecha,
    num_sesiones_estimadas: estimateSessions(fechaInicio, fechaFin),
    tiene_multiples_sesiones: false,
  };
}

function extractDateTimeText($, observacionText) {
  const selectorCandidates = [
    $('span.in-event-date-new').first().text().trim(),
    $('span.in-product-event-date').first().text().trim(),
    $('[class*="event-date"]').first().text().trim(),
  ].filter(Boolean);

  if (selectorCandidates.length > 0) {
    return selectorCandidates[0];
  }

  const collapsedObservacion = (observacionText || '').replace(/\s+/g, ' ').trim();
  if (!collapsedObservacion) {
    return '';
  }

  const englishPrefix = collapsedObservacion.match(/^(?:Mon|Tue|Wed|Thu|Fri|Sat|Sun)\s+\d{1,2}\s+(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)\s+\d{4}\s+\d{1,2}:\d{2}/i);
  if (englishPrefix) {
    return englishPrefix[0];
  }

  const spanishPrefix = collapsedObservacion.match(/^(\d{1,2}(?:\s+Y\s+\d{1,2})?\s+DE\s+[A-Za-zÁÉÍÓÚÜÑáéíóúüñ]+\s+DE\s+\d{4}(?:\s+A\s+LAS\s+\d{1,2}:\d{2}(?:\s+HORAS?)?)?)/i);
  if (spanishPrefix) {
    return spanishPrefix[1];
  }

  return '';
}

const result = [];

    @node({
        id: 'normalize-eventos-cheerio',
        name: 'Normalizar Eventos',
        type: 'n8n-nodes-base.code',
        version: 2,
        position: [1488, -496],
    })
    NormalizarEventos = {
        jsCode: `const cheerio = require('cheerio');

const items = $input.all();
if (!items || items.length === 0) return [];

const MONTHS = {
  JAN: '01', ENERO: '01',
  FEB: '02', FEBRERO: '02',
  MAR: '03', MARZO: '03',
  APR: '04', ABR: '04', ABRIL: '04',
  MAY: '05', MAYO: '05',
  JUN: '06', JUNIO: '06',
  JUL: '07', JULIO: '07',
  AUG: '08', AGO: '08', AGOSTO: '08',
  SEP: '09', SEPT: '09', SEPTIEMBRE: '09',
  OCT: '10', OCTUBRE: '10',
  NOV: '11', NOVIEMBRE: '11',
  DEC: '12', DIC: '12', DICIEMBRE: '12',
};

function normalizeText(value) {
  return (value || '')
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .replace(/s+/g, ' ')
    .trim()
    .toUpperCase();
}

function formatDate(year, monthToken, day) {
  const month = MONTHS[monthToken] || '';
  if (!year || !month || !day) return '';
  return year + '-' + String(month).padStart(2, '0') + '-' + String(day).padStart(2, '0');
}

function estimateSessions(startDate, endDate) {
  if (!startDate) return null;
  if (!endDate) return 1;
  const start = new Date(startDate + 'T00:00:00Z');
  const end = new Date(endDate + 'T00:00:00Z');
  if (Number.isNaN(start.getTime()) || Number.isNaN(end.getTime()) || end < start) return null;
  return Math.round((end.getTime() - start.getTime()) / 86400000) + 1;
}

function parseDateTimeText(originalText) {
  const datetimeTextOriginal = (originalText || '').replace(/s+/g, ' ').trim();
  const normalized = normalizeText(datetimeTextOriginal);
  const timeMatches = Array.from(normalized.matchAll(/(d{1,2}:d{2})/g)).map((match) => match[1]);
  const uniqueTimes = Array.from(new Set(timeMatches));

  if (!normalized) {
    return {
      datetime_text_original: '',
      fecha_inicio: '',
      fecha_fin: '',
      hora_inicio: '',
      tipo_fecha: 'texto_no_parseable',
      num_sesiones_estimadas: null,
      tiene_multiples_sesiones: false,
    };
  }

  if (uniqueTimes.length > 1) {
    return {
      datetime_text_original: datetimeTextOriginal,
      fecha_inicio: '',
      fecha_fin: '',
      hora_inicio: '',
      tipo_fecha: 'multiple_sesiones',
      num_sesiones_estimadas: null,
      tiene_multiples_sesiones: true,
    };
  }

  const dateMatches = Array.from(normalized.matchAll(/(?:MON|TUE|WED|THU|FRI|SAT|SUN|LUN|MAR|MIE|JUE|VIE|SAB|DOM)?s*(d{1,2})s+(JAN|ENERO|FEB|FEBRERO|MAR|MARZO|APR|ABR|ABRIL|MAY|MAYO|JUN|JUNIO|JUL|JULIO|AUG|AGO|AGOSTO|SEP|SEPT|SEPTIEMBRE|OCT|OCTUBRE|NOV|NOVIEMBRE|DEC|DIC|DICIEMBRE)s+(d{4})/g));

  if (dateMatches.length === 0) {
    return {
      datetime_text_original: datetimeTextOriginal,
      fecha_inicio: '',
      fecha_fin: '',
      hora_inicio: uniqueTimes[0] || '',
      tipo_fecha: 'texto_no_parseable',
      num_sesiones_estimadas: null,
      tiene_multiples_sesiones: false,
    };
  }

  const uniqueDates = [];
  for (const match of dateMatches) {
    const formatted = formatDate(match[3], match[2], match[1]);
    if (formatted && !uniqueDates.includes(formatted)) {
      uniqueDates.push(formatted);
    }
  }

  if (uniqueDates.length === 0) {
    return {
      datetime_text_original: datetimeTextOriginal,
      fecha_inicio: '',
      fecha_fin: '',
      hora_inicio: uniqueTimes[0] || '',
      tipo_fecha: 'texto_no_parseable',
      num_sesiones_estimadas: null,
      tiene_multiples_sesiones: false,
    };
  }

  const fechaInicio = uniqueDates[0];
  const fechaFin = uniqueDates.length > 1 ? uniqueDates[uniqueDates.length - 1] : fechaInicio;
  const horaInicio = uniqueTimes[0] || '';
  const tipoFecha = uniqueDates.length > 1 && horaInicio ? 'rango_misma_hora' : 'simple';

  return {
    datetime_text_original: datetimeTextOriginal,
    fecha_inicio: fechaInicio,
    fecha_fin: fechaFin,
    hora_inicio: horaInicio,
    tipo_fecha: tipoFecha,
    num_sesiones_estimadas: estimateSessions(fechaInicio, fechaFin),
    tiene_multiples_sesiones: false,
  };
}

const result = [];

for (let i = 0; i < items.length; i++) {
  try {
    const json = items[i].json || {};
    const data = json.data || {};
    
    // Extraer event_id de la URL (metadata.sourceURL o og:url contiene ?e=EVENT_ID)
    const sourceUrl = (data.metadata && data.metadata.sourceURL) || (data.metadata && data.metadata['og:url']) || '';
    let eventId = '';
    const eventMatch = sourceUrl.match(/[?&]e=([^&]+)/);
    if (eventMatch && eventMatch[1]) {
      eventId = eventMatch[1];
    }

    const html = data.html || data.rawHtml || '';
    const screenshotUrl = data.screenshot || '';
    const ticketeraUrl = sourceUrl;

    if (html.trim().length < 100) {
      console.log('Item', i, ': HTML no disponible, saltando');
      continue;
    }

    const $ = cheerio.load(html);

    // --- titulo ---
    const tituloOriginal = $('h3.select-event-name').first().text().trim();
    const titulo = tituloOriginal;

    // --- local ---
    const local = $('span.in-product-event-loc').first().text().trim();

    // --- observacion ---
    const observacion = $('#select-event-desc').text().replace(new RegExp('\\s+', 'g'), ' ').trim();

    // --- fechas + hora ---
    const dateTimeRaw = extractDateTimeText($, observacion);
    const parsedDateTime = parseDateTimeText(dateTimeRaw);

    // --- cartel ---
    // <img id="select-event-img" src="https://...">
    let cartelUrl = '';
    $('img').each(function(_, el) {
      if ($(el).attr('id') === 'select-event-img') {
        cartelUrl = $(el).attr('src') || '';
      }
    });

    // --- es_gratuito ---
    const descHtml = $('#select-event-desc').html() || '';
    const es_gratuito = /ENTRADA GRATUITA/i.test(descHtml);

    // --- precios ---
    // <span class="ticket-price">€<span id="tix-...-price" value="0">0.00</span></span>
    const prices = [];
    $('.ticket-price span[id]').each((_, el) => {
      const val = parseFloat($(el).text().trim());
      if (!isNaN(val)) prices.push(val);
    });

    const precio_entradas = prices.length > 0 ? Math.min(...prices) : 0;
    const precio_medio_entradas = prices.length > 0
      ? Math.round((prices.reduce((a, b) => a + b, 0) / prices.length) * 100) / 100
      : 0;

    if (!tituloOriginal) {
      console.log('Item', i, ': Sin titulo, saltando');
      continue;
    }

    result.push({
      json: {
        event_id: eventId,
        titulo,
        titulo_original: tituloOriginal,
        observacion,
        datetime_text_original: parsedDateTime.datetime_text_original,
        fecha_inicio: parsedDateTime.fecha_inicio,
        fecha_fin: parsedDateTime.fecha_fin,
        hora_inicio: parsedDateTime.hora_inicio,
        tipo_fecha: parsedDateTime.tipo_fecha,
        num_sesiones_estimadas: parsedDateTime.num_sesiones_estimadas,
        tiene_multiples_sesiones: parsedDateTime.tiene_multiples_sesiones,
        precio_entradas,
        precio_medio_entradas,
        local,
        es_gratuito,
        cartel_url: cartelUrl,
        screenshot_url: screenshotUrl,
        ticketera_url: ticketeraUrl
      },
      pairedItem: { item: i }
    });

  } catch (err) {
    console.log('Error en item', i, ':', err.message);
  }
}

return result;`,
    };

